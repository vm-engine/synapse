@props([
    'name' => '',
    'options' => [],
    'model' => null,
    'multiple' => false,
    'searchable' => true,
    'ajax' => false,
    'ajaxUrl' => '',
    'placeholder' => 'Select option',
    'searchPlaceholder' => 'Search...',
])

@php
    $selectedValues = is_array($model) ? $model : ($model ? [$model] : []);
    $componentId = 'select2-' . $name . '-' . uniqid();
@endphp

<div x-data="{
        name: '{{ $name }}',
        multiple: {{ $multiple ? 'true' : 'false' }},
        searchable: {{ $searchable ? 'true' : 'false' }},
        ajax: {{ $ajax ? 'true' : 'false' }},
        ajaxUrl: '{{ $ajaxUrl }}',
        placeholder: '{{ $placeholder }}',
        searchPlaceholder: '{{ $searchPlaceholder }}',

        isOpen: false,
        loading: false,
        searchQuery: '',

        allOptions: [],
        filteredOptions: [],
        selectedValues: {{ json_encode($selectedValues) }},
        selectedItems: [],

        init() {
            // Initialize with provided options
            @if(!empty($options))
            this.allOptions = {{ Js::from(collect($options)->map(fn($text, $value) => ['value' => (string)$value, 'text' => $text])->values()) }};
            @endif

            this.updateSelectedItems();
            this.filteredOptions = this.allOptions;

            // Load initial data if ajax
            if (this.ajax && this.ajaxUrl) {
                this.loadAjaxData();
            }

            @if($attributes->wire('model')->value())
            // Watch for Livewire model changes from external sources
            this.$watch('$wire.{{ $attributes->wire('model')->value() }}', value => {
                const newValues = Array.isArray(value) ? value : (value ? [value] : []);
                // Only update if values actually changed
                if (JSON.stringify(this.selectedValues.sort()) !== JSON.stringify(newValues.sort())) {
                    this.selectedValues = newValues;
                    this.updateSelectedItems();
                }
            });
            @endif
        },

        toggle() {
            this.isOpen = !this.isOpen;
            if (this.isOpen && this.ajax && this.searchQuery) {
                this.handleSearch();
            }
        },

        close() {
            this.isOpen = false;
            this.searchQuery = '';
            this.filteredOptions = this.allOptions;
        },

        selectOption(option) {
            if (this.multiple) {
                const index = this.selectedValues.indexOf(option.value);
                if (index > -1) {
                    this.selectedValues.splice(index, 1);
                } else {
                    this.selectedValues.push(option.value);
                }
            } else {
                this.selectedValues = [option.value];
                this.close();
            }

            this.updateSelectedItems();
            this.syncWithSelect();
        },

        removeItem(value) {
            const index = this.selectedValues.indexOf(value);
            if (index > -1) {
                this.selectedValues.splice(index, 1);
                this.updateSelectedItems();
                this.syncWithSelect();
            }
        },

        isSelected(value) {
            return this.selectedValues.includes(value);
        },

        updateSelectedItems() {
            this.selectedItems = this.allOptions.filter(opt =>
                this.selectedValues.includes(opt.value)
            );
        },

        handleSearch() {
            if (this.ajax && this.ajaxUrl) {
                this.loadAjaxData(this.searchQuery);
            } else {
                this.filterOptions();
            }
        },

        filterOptions() {
            if (!this.searchQuery) {
                this.filteredOptions = this.allOptions;
                return;
            }

            const query = this.searchQuery.toLowerCase();
            this.filteredOptions = this.allOptions.filter(option =>
                option.text.toLowerCase().includes(query)
            );
        },

        async loadAjaxData(search = '') {
            if (!this.ajaxUrl) return;

            this.loading = true;
            try {
                const url = new URL(this.ajaxUrl, window.location.origin);
                if (search) {
                    url.searchParams.append('search', search);
                }

                const response = await fetch(url);
                const data = await response.json();

                this.allOptions = data;
                this.filteredOptions = data;
                this.updateSelectedItems();
            } catch (error) {
                console.error('Select2 ajax error:', error);
            } finally {
                this.loading = false;
            }
        },

        syncWithSelect() {
            const selectElement = document.getElementById('{{ $componentId }}');
            if (!selectElement) return;

            // Update select element options
            Array.from(selectElement.options).forEach(option => {
                option.selected = this.selectedValues.includes(option.value);
            });

            // Update Livewire via the select element's wire:model
            @if($attributes->wire('model')->value())
            // Trigger Livewire's input event listener
            selectElement.dispatchEvent(new Event('input', { bubbles: true }));
            @else
            // If no wire:model, just dispatch change event for regular form handling
            selectElement.dispatchEvent(new Event('change', { bubbles: true }));
            @endif
        }
    }"
     @click.outside="close()"
     class="relative w-full">

    <!-- Hidden select element for Livewire -->
    <select
        id="{{ $componentId }}"
        name="{{ $name }}"
        {{ $multiple ? 'multiple' : '' }}
        class="hidden"
        {{ $attributes->wire('model') }}
    >
        @foreach($options as $key => $value)
            <option
                value="{{ $key }}"
                {{ in_array((string)$key, array_map('strval', $selectedValues)) ? 'selected' : '' }}
            >
                {{ $value }}
            </option>
        @endforeach
    </select>

    <!-- Custom Select2 UI -->
    <div class="relative">
        <!-- Selected Display / Trigger -->
        <div
            @click="toggle()"
            class="form-input cursor-pointer flex min-h-[2.75rem] py-2
                   @error($name) has-error @enderror"
            :class="{ 'flex-col': multiple && selectedItems.length > 0, 'flex-row items-center justify-between': !(multiple && selectedItems.length > 0) }"
        >
            <!-- Multiple selected items display -->
            <template x-if="multiple && selectedItems.length > 0">
                <div class="flex flex-wrap gap-2 flex-1 mb-2">
                    <template x-for="(item, index) in selectedItems" :key="index">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 dark:bg-brand-900/30
                                     px-2.5 py-0.5 text-sm text-brand-700 dark:text-brand-300">
                            <span x-text="item.text"></span>
                            <button
                                type="button"
                                @click.stop="removeItem(item.value)"
                                class="hover:text-brand-900 dark:hover:text-brand-100"
                            >
                                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </span>
                    </template>
                </div>
            </template>

            <!-- Single selected item display -->
            <template x-if="!multiple && selectedItems.length > 0">
                <span x-text="selectedItems[0].text" class="text-gray-900 dark:text-white"></span>
            </template>

            <!-- Placeholder -->
            <template x-if="selectedItems.length === 0">
                <span class="text-gray-500 dark:text-gray-400" x-text="placeholder"></span>
            </template>

            <!-- Dropdown arrow -->
            <svg
                class="h-5 w-5 text-gray-400 transition-transform"
                :class="{ 'rotate-180': isOpen, 'ml-2': !(multiple && selectedItems.length > 0), 'self-end': multiple && selectedItems.length > 0 }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>

        <!-- Dropdown panel -->
        <div
            x-show="isOpen"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            class="absolute z-50 w-full mt-1 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700
                   rounded-lg shadow-lg max-h-60 flex flex-col"
            style="display: none;"
        >
            <!-- Search input -->
            <template x-if="searchable">
                <div class="p-2 border-b border-gray-200 dark:border-gray-800">
                    <input
                        type="text"
                        x-model="searchQuery"
                        @input="handleSearch()"
                        :placeholder="searchPlaceholder"
                        class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-700
                               rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500
                               dark:bg-gray-800 dark:text-white"
                        @click.stop
                    />
                </div>
            </template>

            <!-- Loading state -->
            <template x-if="loading">
                <div class="p-4 text-center text-gray-500 dark:text-gray-400">
                    <svg class="animate-spin h-5 w-5 mx-auto" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="text-sm mt-2 block">Loading...</span>
                </div>
            </template>

            <!-- Options list -->
            <div x-show="!loading" class="overflow-y-auto flex-1">
                <template x-if="filteredOptions.length === 0">
                    <div class="p-4 text-center text-sm text-gray-500 dark:text-gray-400">
                        No options found
                    </div>
                </template>

                <template x-for="(option, index) in filteredOptions" :key="option.value">
                    <div
                        @click="selectOption(option)"
                        class="px-3 py-2 cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-800
                               flex items-center justify-between"
                        :class="{
                            'bg-brand-50 dark:bg-brand-900/20 border-l-2 border-brand-500': isSelected(option.value)
                        }"
                    >
                        <span x-text="option.text" class="text-sm text-gray-900 dark:text-white"></span>
                        <template x-if="multiple && isSelected(option.value)">
                            <svg class="h-4 w-4 text-brand-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                        </template>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>
