{
    "name": "vm-engine/synapse",
    "description": "HP Synapse rebuild using Livewire and as Laravel Package",
    "type": "library",
    "require": {
        "laravel/framework": "12.x",
        "livewire/livewire": "3.x",
        "composer/semver": "^3.0"
    },
    "require-dev": {
        "laradumps/laradumps": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Synapse\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "theadods@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\Synapse\\SynapseServiceProvider",
                "VmEngine\\Synapse\\SynapseLangServiceProvider",
                "VmEngine\\Synapse\\SynapseRouteServiceProvider",
                "VmEngine\\Synapse\\SynapseViewServiceProvider"
            ]
        }
    }
}
