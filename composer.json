{
    "name": "vm-engine/synapse",
    "description": "HP Synapse rebuild using Livewire and as Laravel Package",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "composer/semver": "^3.0",
        "openspout/openspout": "^4.0",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "require-dev": {
        "laradumps/laradumps": "^5.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "mews/purifier": "^3.4"
    },
    "suggest": {
        "mews/purifier": "HTML sanitiser for the optional rich-text editor (added to the host when rte.enabled is on)",
        "laravel/scout": "Optional search engine for SynSearchable (set synapps.apps.searchable.engine = scout)"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Synapse\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "theadods@gmail.com"
        }
    ],
    "bin": [
        "bin/synmod-make"
    ],
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        },
        "laravel": {
            "providers": [
                "VmEngine\\Synapse\\SynapseServiceProvider",
                "VmEngine\\Synapse\\SynapseLangServiceProvider",
                "VmEngine\\Synapse\\SynapseRouteServiceProvider",
                "VmEngine\\Synapse\\SynapseViewServiceProvider"
            ]
        }
    }
}
