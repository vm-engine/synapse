{
    "name": "vm-engine/synapse",
    "version": "1.7.3",
    "description": "HP Synapse rebuild using Livewire and as Laravel Package",
    "type": "library",
    "require": {
        "laravel/framework": "12.x",
        "livewire/livewire": "^4.0",
        "composer/semver": "^3.0",
        "openspout/openspout": "^4.0",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "require-dev": {
        "laradumps/laradumps": "^4.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "VmEngine\\Synapse\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Achmad Ardiansyah",
            "email": "theadods@gmail.com"
        }
    ],
    "bin": [
        "bin/synmod-make"
    ],
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VmEngine\\Synapse\\SynapseServiceProvider",
                "VmEngine\\Synapse\\SynapseLangServiceProvider",
                "VmEngine\\Synapse\\SynapseRouteServiceProvider",
                "VmEngine\\Synapse\\SynapseViewServiceProvider"
            ]
        }
    }
}
