includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src

    # Level 9 is the highest level
    level: 7

    ignoreErrors:
        # Intentional env() call for config generation in Builder
        -
            message: "#Called 'env' outside of the config directory#"
            path: src/Services/ConfigGenerator/Builder.php

        # DatabaseSeeder is from the Laravel app, not package
        -
            message: "#Class Database\\\\Seeders\\\\DatabaseSeeder not found#"
            path: src/SynapseServiceProvider.php

        # View component render methods - false positive
        -
            message: "#Parameter .* of function view expects view-string#"
            paths:
                - src/Components/*.php

        # Traits are library code meant to be used by consuming packages
        -
            message: "#Trait .* is used zero times and is not analysed#"
            paths:
                - src/Traits/*.php

        # Eloquent casts enum comparison - PHPDoc infers string but runtime is enum
        -
            message: "#Strict comparison using ===.* will always evaluate to false#"
            paths:
                - src/Models/Excel*.php
                - src/Jobs/ProcessExcel*.php
                - src/Services/Excel/Excel*.php
        -
            message: "#Strict comparison using !==.* will always evaluate to true#"
            paths:
                - src/Models/Excel*.php
                - src/Jobs/ProcessExcel*.php
                - src/Services/Excel/Excel*.php
        -
            message: "#Result of && is always false#"
            paths:
                - src/Models/Excel*.php
                - src/Jobs/ProcessExcel*.php
                - src/Services/Excel/Excel*.php
        -
            message: "#Unreachable statement - code above always terminates#"
            paths:
                - src/Models/Excel*.php
                - src/Jobs/ProcessExcel*.php
                - src/Services/Excel/Excel*.php
        -
            message: "#Cannot access property .* on string#"
            paths:
                - src/Models/Excel*.php
                - src/Jobs/ProcessExcel*.php
                - src/Services/Excel/Excel*.php

        # Runtime validation guards - PHPDoc narrows type before check
        -
            message: "#Call to function is_subclass_of.* will always evaluate to true#"
            paths:
                - src/Services/Excel/Excel*.php
                - src/Jobs/ProcessExcel*.php
        -
            message: "#function.alreadyNarrowedType#"
            paths:
                - src/Services/Excel/Excel*.php
                - src/Jobs/ProcessExcel*.php

        # Property written for API but read externally
        -
            message: "#Property .* is never read, only written#"
            paths:
                - src/Services/Excel/Readers/*.php
                - src/Services/Excel/Writers/*.php

        # ColumnMapper return type - sequential array treated as list
        -
            message: "#should return array<string, mixed> but returns array<int, mixed>#"
            path: src/Services/Excel/Support/ColumnMapper.php

        # SynapseFinder addLocation call - parent class dynamically resolved at runtime
        -
            message: "#Call to an undefined method VmEngine\\\\Synapse\\\\Finder\\\\SynapseFinder::addLocation\\(\\)#"
            path: src/SynapseServiceProvider.php

    reportUnmatchedIgnoredErrors: false

    excludePaths:
        # Livewire Finder class location varies across Livewire versions; SynapseFinder overrides livewire.finder at runtime
        - src/Finder/SynapseFinder.php
