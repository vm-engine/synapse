includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src

    level: 7

    # Larastan's bare Testbench app never registers the `synapse::` view
    # namespace; this bootstrap registers it so view-string checks resolve.
    bootstrapFiles:
        - phpstan-bootstrap.php

    ignoreErrors:
        # Intentional env() call: resolves `env::` placeholders while generating config files
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: src/Services/ConfigGenerator/Builder.php

        # vm-engine/synapps-auth is an optional runtime dependency (guarded by
        # NotificationSetup::authInstalled()); its Role model isn't installed here.
        -
            identifier: class.notFound
            path: src/Notifications/Notify.php

        # Library traits used only by consuming packages
        -
            identifier: trait.unused
            paths:
                - src/Traits/*.php
                - src/Notifications/Concerns/*.php

    excludePaths:
        # Livewire Finder class location varies across Livewire versions; SynapseFinder overrides livewire.finder at runtime
        - src/Finder/SynapseFinder.php
        # laravel/scout is optional (suggest); this model is only loaded when it's installed.
        - src/Models/ScoutSearchable.php
